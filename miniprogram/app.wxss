page {
  --primary: #1b3a6b;
  --primary-strong: #122a4f;
  --ink: #15233a;
  --muted: #5d6b80;
  --border: #dbe2ec;
  --surface: #ffffff;
  --soft: #f4f7fb;
  --good: #1e6b34;
  --good-bg: #e6f4ea;
  --warn: #8a5a00;
  --warn-bg: #fff4e0;
  --bad: #a32424;
  --bad-bg: #fdeaea;
  background: #eef2f7;
  color: var(--ink);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", Helvetica, sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
}

.page { padding: 24rpx 24rpx 60rpx; }

/* ---------- Card ---------- */
.card {
  background: var(--surface);
  border: 1rpx solid var(--border);
  border-radius: 28rpx;
  box-shadow: 0 4rpx 24rpx rgba(27, 58, 107, 0.06);
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--primary);
  margin: 8rpx 0 20rpx;
}
.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.section-head .section-title { margin: 0; }

.muted { color: var(--muted); font-size: 26rpx; }
.text-bad { color: var(--bad); }
.text-good { color: var(--good); }

/* ---------- Buttons ---------- */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 84rpx;
  padding: 0 40rpx;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 700;
  border: none;
  line-height: 1.2;
}
.btn::after { border: none; }
.btn-primary { background: var(--primary); color: #fff; }
.btn-primary:active { background: var(--primary-strong); }
.btn-ghost { background: #eef2f7; color: var(--muted); }
.btn-danger { background: var(--bad-bg); color: var(--bad); }
.btn-block { width: 100%; }
.btn-sm { min-height: 60rpx; padding: 0 28rpx; font-size: 26rpx; }

.icon-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  opacity: 0.6;
  background: transparent;
  line-height: 1;
  padding: 0;
}
.icon-btn::after { border: none; }

/* ---------- Forms ---------- */
.form-heading { font-size: 30rpx; font-weight: 700; color: var(--primary); margin-bottom: 8rpx; }
.field { margin-bottom: 22rpx; }
.field-label { display: block; font-size: 26rpx; font-weight: 600; margin-bottom: 10rpx; }
.field-input, .picker-box {
  width: 100%;
  box-sizing: border-box;
  min-height: 84rpx;
  padding: 18rpx 24rpx;
  background: #fff;
  border: 1rpx solid var(--border);
  border-radius: 18rpx;
  font-size: 30rpx;
  color: var(--ink);
}
.picker-box { display: flex; align-items: center; justify-content: space-between; }
.picker-box.placeholder { color: #9aa6b8; }
.picker-arrow { color: #9aa6b8; font-size: 24rpx; }
textarea.field-input { min-height: 110rpx; }
.form-error {
  background: var(--bad-bg);
  color: var(--bad);
  border-radius: 16rpx;
  padding: 16rpx 22rpx;
  font-size: 26rpx;
  font-weight: 600;
  margin-top: 6rpx;
}

/* ---------- Empty state ---------- */
.empty {
  text-align: center;
  padding: 80rpx 32rpx;
}
.empty-icon { font-size: 88rpx; }
.empty-title { font-size: 34rpx; font-weight: 700; margin: 20rpx 0 8rpx; }
.empty-text { color: var(--muted); margin-bottom: 32rpx; }

/* ---------- Progress bar ---------- */
.bar { height: 18rpx; border-radius: 999rpx; background: var(--border); overflow: hidden; }
.bar-fill { height: 100%; border-radius: 999rpx; background: var(--primary); }
.bar-fill.good { background: var(--good); }
.bar-fill.warn { background: var(--warn); }
.bar-fill.bad { background: var(--bad); }
.bar-text { font-size: 24rpx; color: var(--muted); font-weight: 600; margin-top: 10rpx; }

/* ---------- Badges / pills ---------- */
.badge { font-size: 22rpx; font-weight: 700; padding: 2rpx 14rpx; border-radius: 999rpx; }
.badge-current { background: var(--primary); color: #fff; }
.pill {
  display: inline-block;
  padding: 2rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.2);
  font-size: 24rpx;
  font-weight: 700;
  margin-left: 12rpx;
}
