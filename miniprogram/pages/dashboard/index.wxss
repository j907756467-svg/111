.hero {
  background: linear-gradient(135deg, #1b3a6b 0%, #122a4f 100%);
  color: #fff;
  border-radius: 28rpx;
  padding: 36rpx 32rpx;
  margin-bottom: 24rpx;
}
.hero-eyebrow { font-size: 24rpx; color: rgba(255, 255, 255, 0.8); }
.hero-title { font-size: 42rpx; font-weight: 800; margin: 10rpx 0; }
.hero-dates { font-size: 28rpx; color: rgba(255, 255, 255, 0.85); }

.stat-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
  margin-bottom: 24rpx;
}
.stat-card {
  flex: 1 1 45%;
  box-sizing: border-box;
  background: var(--surface);
  border: 1rpx solid var(--border);
  border-radius: 24rpx;
  padding: 24rpx;
}
.stat-card.good { background: var(--good-bg); }
.stat-card.warn { background: var(--warn-bg); }
.stat-card.bad { background: var(--bad-bg); }
.stat-label { font-size: 24rpx; color: var(--muted); font-weight: 700; }
.stat-value { font-size: 44rpx; font-weight: 800; margin-top: 8rpx; }
.stat-unit { font-size: 26rpx; font-weight: 600; color: var(--muted); }
.stat-sub { font-size: 24rpx; color: var(--muted); margin-top: 4rpx; }
.stat-link { font-size: 24rpx; color: var(--primary); font-weight: 700; margin-top: 10rpx; }

.next-item {
  background: var(--soft);
  border-left: 6rpx solid var(--primary);
  border-radius: 18rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 16rpx;
}
.next-item:last-child { margin-bottom: 0; }
.next-when { font-size: 24rpx; color: var(--muted); font-weight: 700; }
.next-title { font-weight: 700; margin: 4rpx 0; }
.next-loc { font-size: 24rpx; color: var(--muted); }

.trip-mini {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  background: var(--soft);
  border: 1rpx solid var(--border);
  border-radius: 20rpx;
  padding: 22rpx 24rpx;
  margin-bottom: 16rpx;
}
.trip-mini:last-child { margin-bottom: 0; }
.trip-mini.is-current { border-color: var(--primary); }
.trip-mini-name { font-weight: 700; }
.trip-mini-meta { font-size: 24rpx; color: var(--muted); margin-top: 4rpx; }
.trip-mini-spend { font-weight: 700; white-space: nowrap; }

.note-card { background: var(--soft); }
