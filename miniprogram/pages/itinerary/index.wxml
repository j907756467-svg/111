<view class="page">

  <block wx:if="{{!hasTrip}}">
    <view class="card empty">
      <view class="empty-icon">🧭</view>
      <view class="empty-title">请先选择一段行程</view>
      <view class="empty-text">日程属于具体的某次出差。</view>
      <button class="btn btn-primary" bindtap="goTrips">前往行程管理</button>
    </view>
  </block>

  <block wx:else>
    <!-- Add form -->
    <view class="card">
      <view class="form-heading">添加日程</view>

      <view class="field-row">
        <view class="field half">
          <text class="field-label">类型</text>
          <picker mode="selector" range="{{typeLabels}}" value="{{form.typeIndex}}" bindchange="onType">
            <view class="picker-box"><text>{{typeLabels[form.typeIndex]}}</text><text class="picker-arrow">▾</text></view>
          </picker>
        </view>
        <view class="field half">
          <text class="field-label">时间</text>
          <picker mode="time" value="{{form.time}}" bindchange="onTime">
            <view class="picker-box {{form.time ? '' : 'placeholder'}}"><text>{{form.time || '选填'}}</text><text class="picker-arrow">▾</text></view>
          </picker>
        </view>
      </view>

      <view class="field">
        <text class="field-label">日期</text>
        <picker mode="date" value="{{form.date}}" bindchange="onDate">
          <view class="picker-box {{form.date ? '' : 'placeholder'}}"><text>{{form.date || '选择日期'}}</text><text class="picker-arrow">▾</text></view>
        </picker>
      </view>

      <view class="field">
        <text class="field-label">事项 *</text>
        <input class="field-input" maxlength="80" data-field="title" value="{{form.title}}"
               bindinput="onInput" placeholder="如：CA1858 北京→上海 / 客户会议" />
      </view>

      <view class="field">
        <text class="field-label">地点</text>
        <input class="field-input" maxlength="60" data-field="location" value="{{form.location}}"
               bindinput="onInput" placeholder="如：首都T3 / 客户总部" />
      </view>

      <view class="field">
        <text class="field-label">备注</text>
        <input class="field-input" maxlength="120" data-field="notes" value="{{form.notes}}"
               bindinput="onInput" placeholder="提醒事项" />
      </view>

      <view wx:if="{{error}}" class="form-error">{{error}}</view>
      <button class="btn btn-primary btn-block" style="margin-top:8rpx" bindtap="add">添加到日程</button>
    </view>

    <!-- Timeline -->
    <view class="card">
      <view wx:if="{{groups.length === 0}}" class="muted">还没有日程安排，使用上方表单添加第一项。</view>

      <view wx:for="{{groups}}" wx:key="date" class="day-group">
        <view class="day-head">{{item.dateLabel}}</view>
        <view wx:for="{{item.items}}" wx:for-item="it" wx:key="id" class="tl-item">
          <view class="tl-time">{{it.time}}</view>
          <view class="tl-icon">{{it.icon}}</view>
          <view class="tl-body">
            <view class="tl-title">{{it.title}}</view>
            <view wx:if="{{it.location || it.notes}}" class="tl-meta">
              <text wx:if="{{it.location}}">📍 {{it.location}}</text>
              <text wx:if="{{it.notes}}"> · {{it.notes}}</text>
            </view>
          </view>
          <button class="icon-btn" data-id="{{it.id}}" catchtap="remove">🗑️</button>
        </view>
      </view>
    </view>
  </block>

</view>
