.field-row { display: flex; gap: 20rpx; }
.field.half { flex: 1; }

.day-group { margin-bottom: 28rpx; }
.day-group:last-child { margin-bottom: 0; }
.day-head {
  font-size: 28rpx;
  font-weight: 800;
  color: var(--primary);
  padding-bottom: 12rpx;
  margin-bottom: 16rpx;
  border-bottom: 2rpx dashed var(--border);
}
.tl-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: var(--soft);
  border-radius: 18rpx;
  padding: 18rpx 20rpx;
  margin-bottom: 14rpx;
}
.tl-item:last-child { margin-bottom: 0; }
.tl-time { width: 96rpx; font-size: 24rpx; font-weight: 700; color: var(--muted); }
.tl-icon { font-size: 36rpx; width: 48rpx; text-align: center; }
.tl-body { flex: 1; min-width: 0; }
.tl-title { font-weight: 700; }
.tl-meta { font-size: 24rpx; color: var(--muted); margin-top: 4rpx; }
